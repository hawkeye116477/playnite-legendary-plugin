<UserControl x:Class="LegendaryLibraryNS.LegendaryGameSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:common="clr-namespace:CommonPlugin"
             xmlns:system="clr-namespace:System"
             xmlns:pcmd="clr-namespace:Playnite.Commands"
             xmlns:local="clr-namespace:LegendaryLibraryNS"
             mc:Ignorable="d"
             d:DesignHeight="550" d:DesignWidth="600" Loaded="LegendaryGameSettingsViewUC_Loaded"
             Name="LegendaryGameSettingsViewUC"
             d:DataContext="{d:DesignInstance Type=local:LegendaryGameSettingsViewModel }">
    <UserControl.Resources>
        <Style TargetType="Separator" BasedOn="{StaticResource HawkeyeSeparatorStyle}" />
        <Style TargetType="Border" BasedOn="{StaticResource HawkeyeBorderStyle}" />
        <Style TargetType="ListBox" BasedOn="{StaticResource HawkeyeListBoxStyle}" />
        <Style TargetType="TextBlock" BasedOn="{StaticResource HawkeyeTextBlockStyle}" />
        <Style TargetType="Button" BasedOn="{StaticResource HawkeyeButtonStyle}" />
        <Style TargetType="Expander" BasedOn="{StaticResource HawkeyeExpanderStyle}" />
        <Style TargetType="TabControl" BasedOn="{StaticResource HawkeyeTabControlStyle}" />
    </UserControl.Resources>
    <TabControl ScrollViewer.VerticalScrollBarVisibility="Disabled"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <TabItem Header="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSettingsGeneralLabel}}">
            <StackPanel Margin="10,10,10,0">
                <StackPanel Grid.Column="0" Grid.Row="2" Margin="0,0,8,8" Orientation="Horizontal" Name="VersionSP">
                    <TextBlock Text="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteVersionLabel}}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsEnabled="False" />
                    <TextBox Name="GameVersionTxt" Margin="8,0,0,0" IsReadOnly="True"></TextBox>
                </StackPanel>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <CheckBox Grid.Column="0" Grid.Row="0"
                              Content="{common:Localize Key={x:Static system:LOC.CommonDisableGameUpdateChecking}}"
                              Margin="0,0,0,8" x:Name="DisableGameUpdateCheckingChk"
                              IsChecked="{Binding ChosenGameSettings.DisableGameVersionCheck}" />
                    <CheckBox Grid.Column="0" Grid.Row="1"
                              Content="{common:Localize Key={x:Static system:LOC.LegendaryEnableOfflineMode}}"
                              Margin="0,0,0,8" x:Name="EnableOfflineModeChk" IsEnabled="False"
                              IsChecked="{Binding ChosenGameSettings.LaunchOffline}" />
                    <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonStartupArguments}}"
                               Grid.Column="0"
                               Grid.Row="2" Margin="0,0,8,8" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBox x:Name="StartupArgumentsTxt"
                             Grid.Column="1" Grid.Row="2" Margin="0,0,0,8" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left" Text="{Binding StartupArgumentsTxt}" />
                    <Button x:Name="StartupArgumentsHelpBtn"
                            Grid.Column="2" Grid.Row="2" Margin="8,0,0,8" Content="&#xefca;"
                            FontFamily="{DynamicResource IcoFont}"
                            Command="{x:Static pcmd:GlobalCommands.NavigateUrlCommand}"
                            CommandParameter="https://github.com/hawkeye116477/playnite-legendary-plugin/wiki/Game-startup-arguments" />
                    <TextBlock Text="{common:Localize Key={x:Static system:LOC.LegendaryLanguageCode}}"
                               Grid.Column="0"
                               Grid.Row="3" Margin="0,0,5,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBox x:Name="LanguageCodeTxt"
                             Grid.Column="1" Grid.Row="3" Margin="0,0,0,5" VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left" Text="{Binding ChosenGameSettings.LanguageCode}" />

                    <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonAlternativeExe}}"
                               Grid.Column="0" Grid.Row="4"
                               Margin="0,0,5,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <TextBox x:Name="SelectedAlternativeExeTxt"
                             Grid.Row="4" Grid.Column="1" Margin="10,0,0,5" VerticalAlignment="Center"
                             Text="{Binding ChosenGameSettings.OverrideExe}" />
                    <Button Name="ChooseAlternativeExeBtn"
                            Margin="5,0,0,5" Content="&#xec5b;" FontFamily="{DynamicResource IcoFont}" Grid.Row="4"
                            Grid.Column="2"
                            ToolTip="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSelectFileTooltip}}"
                            VerticalAlignment="Center" Click="ChooseAlternativeExeBtn_Click" />
                </Grid>
            </StackPanel>
        </TabItem>
        <TabItem Header="{common:Localize Key={x:Static system:LOC.CommonCloud}}">
            <StackPanel Margin="10">
                <CheckBox Name="AutoSyncPlaytimeChk"
                          Content="{common:Localize Key={x:Static system:LOC.CommonSyncPlaytime}}"
                          Margin="0,0,0,10" IsChecked="{Binding ChosenGameSettings.AutoSyncPlaytime}" />
                <StackPanel x:Name="CloudSavesSP">
                    <CheckBox Name="AutoSyncSavesChk"
                              Content="{common:Localize Key={x:Static system:LOC.CommonAutoSyncSaves}}"
                              Margin="0,0,0,10" Click="AutoSyncSavesChk_Click"
                              IsChecked="{Binding ChosenGameSettings.AutoSyncSaves}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonSavePath}}"
                                   Grid.Column="0" Grid.Row="1"
                                   Margin="0,0,10,5" VerticalAlignment="Center" HorizontalAlignment="Left" />
                        <TextBox x:Name="SelectedSavePathTxt" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"
                                 VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                 Text="{Binding ChosenGameSettings.CloudSaveFolder}" />
                        <Button Name="ChooseSavePathBtn"
                                Margin="5,0,0,5" Content="&#xec5b;" FontFamily="{DynamicResource IcoFont}"
                                Grid.Row="1" Grid.Column="2"
                                ToolTip="{common:Localize Key={x:Static system:LOC.ThirdPartyPlayniteSelectDirectoryTooltip}}"
                                VerticalAlignment="Center" Click="ChooseSavePathBtn_Click" />
                        <Button Name="CalculatePathBtn" Margin="8,0,0,5" Grid.Row="1" Grid.Column="3"
                                VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="&#xef85;"
                                ToolTip="{common:Localize Key={x:Static system:LOC.CommonCalculatePath}}"
                                FontFamily="{DynamicResource IcoFont}" Click="CalculatePathBtn_Click" />
                    </Grid>
                    <TextBlock Text="{common:Localize Key={x:Static system:LOC.CommonManualSyncSaves}}"
                               FontSize="15" Margin="0,10,10,2" VerticalAlignment="Center" />
                    <Separator Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="ManualSyncSavesCBo" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  VerticalAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Left" Margin="0,0,0,0" HorizontalAlignment="Left" />
                        <CheckBox x:Name="ForceCloudActionChk" VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Content="{common:Localize Key={x:Static system:LOC.CommonForceAction}}"
                                  Margin="15,0,0,0" />
                        <Button x:Name="SyncSavesBtn"
                                Content="{common:Localize Key={x:Static system:LOC.CommonSync}}"
                                HorizontalAlignment="Left" Margin="15,0,0,0" Click="SyncSavesBtn_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </TabItem>
    </TabControl>
</UserControl>